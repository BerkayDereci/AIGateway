# Development only. Replace every CHANGE_ME locally. Never commit real values.
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=aigateway
POSTGRES_USER=aigateway
POSTGRES_PASSWORD=CHANGE_ME
ConnectionStrings__Default=Host=postgres;Database=aigateway;Username=aigateway;Password=CHANGE_ME
Storage__Endpoint=http://minio:9000
Storage__Bucket=aigateway-private
Storage__AccessKey=CHANGE_ME
Storage__SecretKey=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
DataProtection__KeyRingPath=/var/lib/aigateway/keyring
Demo__Enabled=true
Telemetry__IncludeContent=false
Limits__UploadMaxBytes=10485760
Limits__ImageMaxPixels=20000000
Limits__RequestTimeoutSeconds=120
# Provider secrets are entered via protected Provider Connections UI.
# Model IDs and prices must be verified and configured; no defaults here.

# --- Added by implementation (compose wiring; keep CHANGE_ME values local) ---
# Storage keys must equal the MinIO root credentials above for the local stack.
RateLimit__AuthPerMinute=10
# Production only: PFX that protects the Data Protection keyring (startup fails closed without it).
DataProtection__CertificatePath=
DataProtection__CertificatePassword=
# Production behind a different origin only; the bundled nginx proxy is same-origin.
# Cors__AllowedOrigins__0=https://panel.example.com
# Optional OpenTelemetry export (metrics + traces, no prompt content).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
